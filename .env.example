# Copy to .env and adjust. Never commit .env.
# Every config var the backend reads must be listed here with a default.

# --- Database -------------------------------------------------------------
# These match the local Docker Postgres (docker-compose.yml).
# The app picks the driver (asyncpg for the API, psycopg for ingest/jobs).
DATABASE_URL=postgresql://uhnime:uhnime@localhost:5432/uhnime
# Used only by pytest. Must be a separate database; tests roll back per test.
TEST_DATABASE_URL=postgresql://uhnime:uhnime@localhost:5432/uhnime_test

# --- Ingest ---------------------------------------------------------------
# Descriptive User-Agent sent to AniList / MAL / Wikidata. Include a project URL.
INGEST_USER_AGENT=uh-ni-me/0.1 (+https://github.com/YOUR_USERNAME/uh-ni-me)
# MyAnimeList API v2 client ID. Only needed for F-012 (later).
MAL_CLIENT_ID=

# --- Answer matching ------------------------------------------------------
# pg_trgm similarity cutoff (0-1) for fuzzy matches. Placeholder; tune with tests.
MATCH_SIMILARITY_THRESHOLD=0.4

# --- Game timer -----------------------------------------------------------
ANSWER_TIME_LIMIT_SECONDS=25
# Extra server-side allowance for network latency.
ANSWER_GRACE_SECONDS=2
# Cap on guesses per prompt, so scripts can't brute-force rare answers.
MAX_GUESSES_PER_PROMPT=20

# --- Prompt generation ----------------------------------------------------
PROMPT_MIN_ANSWERS=25
PROMPT_MAX_ANSWERS=500
PROMPT_REPEAT_WINDOW_DAYS=60
# Seed for deterministic daily puzzle selection.
PUZZLE_SEED=uh-ni-me

# --- Scoring --------------------------------------------------------------
# Submissions a prompt needs before times_answered is blended into rarity.
SCORING_BLEND_MIN_SUBMISSIONS=50

# --- Frontend -------------------------------------------------------------
# Next.js reads env from frontend/, so put this in frontend/.env.local.
# Next.js proxies the browser's /api/* calls to this backend address.
# API_URL=http://localhost:8000
